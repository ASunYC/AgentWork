{
  "name": "@agentwork/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm prepare:deps && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prepare:deps": "pnpm --filter @agentwork/contracts build && pnpm --filter @agentwork/database build",
    "typecheck": "pnpm prepare:deps && tsc -p tsconfig.json --noEmit",
    "test": "pnpm prepare:deps && vitest run",
    "openapi:generate": "pnpm build && node dist/openapi.generate.js"
  },
  "dependencies": {
    "@agentwork/contracts": "workspace:*",
    "@agentwork/database": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "10.16.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "prisma": "5.22.0",
    "supertest": "^7.0.0"
  }
}
