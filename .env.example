# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
AUTH_JWT_SECRET=replace-with-a-long-random-session-secret
CHALLENGE_SECRET=replace-with-a-distinct-long-random-challenge-secret

# PostgreSQL
POSTGRES_DB=agentwork
POSTGRES_USER=agentwork
POSTGRES_PASSWORD=agentwork_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agentwork:agentwork_local@localhost:5432/agentwork?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (local development only)
MINIO_ROOT_USER=agentwork
MINIO_ROOT_PASSWORD=agentwork_local_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agentwork
S3_ACCESS_KEY=agentwork
S3_SECRET_KEY=agentwork_local_secret
S3_REGION=us-east-1

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
