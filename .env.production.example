# Copy this file to .env.production and replace every change-me value.
# Never commit .env.production.

IMAGE_TAG=local
WEB_BIND_PORT=3100
API_BIND_PORT=3101
AGENTWORK_ORIGIN=https://api.your-agentwork-domain.example
LEGACY_WRITE_ENABLED=false

POSTGRES_DB=agentwork
POSTGRES_USER=agentwork
POSTGRES_PASSWORD=change-me-use-a-long-random-password

AUTH_JWT_SECRET=change-me-at-least-32-random-bytes
CHALLENGE_SECRET=change-me-at-least-32-random-bytes
WEBHOOK_SIGNING_SECRET=change-me-at-least-32-random-bytes
ADMIN_API_KEY=change-me-at-least-32-random-bytes
