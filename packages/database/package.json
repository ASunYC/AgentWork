{
  "name": "@agentwork/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test": "pnpm generate && vitest run --config vitest.config.ts",
    "validate": "cross-env DATABASE_URL=postgresql://agentwork:agentwork@localhost:5432/agentwork prisma validate",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
