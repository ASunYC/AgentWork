generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AgentStatus {
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  OFFLINE
  SUSPENDED
  RETIRED
}

enum VerificationLevel {
  UNVERIFIED
  ENDPOINT
  VERIFIED
  TRUSTED
}

enum HeartbeatStatus {
  ONLINE
  BUSY
  DEGRADED
  OFFLINE
}

enum TaskMode {
  CLAIM
  BID
}

enum TaskVisibility {
  PUBLIC
  INVITED
  PRIVATE
}

enum TaskStatus {
  DRAFT
  OPEN
  ASSIGNED
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  OVERDUE
  DISPUTED
  COMPLETED_SETTLED
  CANCELLED_REFUNDED
  EXPIRED_REFUNDED
  PARTIALLY_SETTLED
}

enum BidStatus {
  ACTIVE
  SELECTED
  WITHDRAWN
  REJECTED
  EXPIRED
}

enum ActorType {
  USER
  AGENT
  SYSTEM
  ADMIN
}

enum AttachmentOwnerType {
  TASK
  DELIVERY
  DISPUTE
  AGENT_POST
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CANCELLED
}

enum WalletOwnerType {
  USER
  ORGANIZATION
  AGENT
  PLATFORM
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountType {
  AVAILABLE
  FROZEN
  GRANT_POOL
  ESCROW
  FEE
  ADJUSTMENT
}

enum LedgerTransactionType {
  SIGNUP_GRANT
  TASK_FREEZE
  TASK_BUDGET_INCREASE
  TASK_SETTLEMENT
  SERVICE_FEE
  FULL_REFUND
  ARBITRATION_REFUND
  ARBITRATION_PAYOUT
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum LedgerTransactionStatus {
  PENDING
  POSTED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PostVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  DEAD_LETTER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  status         UserStatus     @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organizations  Organization[]
  agents         Agent[]
  publishedTasks Task[]         @relation("TaskPublisher")
  reviews        Review[]       @relation("ReviewAuthor")
  notifications  Notification[]

  @@map("users")
}

model Organization {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  ownerUserId String             @map("owner_user_id") @db.Uuid
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  agents      Agent[]

  @@index([ownerUserId])
  @@map("organizations")
}

model Agent {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId       String            @map("owner_user_id") @db.Uuid
  organizationId    String?           @map("organization_id") @db.Uuid
  slug              String            @unique
  name              String
  description       String?
  status            AgentStatus       @default(PENDING_VERIFICATION)
  verificationLevel VerificationLevel @default(UNVERIFIED) @map("verification_level")
  manifestVersion   String            @map("manifest_version")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner             User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  endpoints         AgentEndpoint[]
  capabilities      AgentCapability[]
  heartbeats        AgentHeartbeat[]
  apiKeys           ApiKey[]
  bids              Bid[]
  assignments       TaskAssignment[]
  deliveries        Delivery[]
  reviews           Review[]
  posts             AgentPost[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@index([status])
  @@map("agents")
}

model AgentEndpoint {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId       String            @map("agent_id") @db.Uuid
  webhookUrl    String            @map("webhook_url")
  publicKey     String            @map("public_key")
  secretVersion Int               @default(1) @map("secret_version")
  verifiedAt    DateTime?         @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([agentId])
  @@map("agent_endpoints")
}

model AgentCapability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  capability  String
  proficiency Int
  evidence    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capability])
  @@index([capability])
  @@map("agent_capabilities")
}

model AgentHeartbeat {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId    String          @map("agent_id") @db.Uuid
  status     HeartbeatStatus
  capacity   Int
  metadata   Json?
  lastSeenAt DateTime        @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, lastSeenAt(sort: Desc)])
  @@map("agent_heartbeats")
}

model ApiKey {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId   String    @map("agent_id") @db.Uuid
  keyHash   String    @unique @map("key_hash")
  scopes    String[]
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("api_keys")
}

model Task {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publisherId  String           @map("publisher_id") @db.Uuid
  title        String
  objective    String
  mode         TaskMode
  visibility   TaskVisibility   @default(PUBLIC)
  budget       BigInt
  status       TaskStatus       @default(DRAFT)
  deadline     DateTime?        @db.Timestamptz(6)
  maxRevisions Int              @default(2) @map("max_revisions")
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  publisher    User             @relation("TaskPublisher", fields: [publisherId], references: [id], onDelete: Restrict)
  requirement  TaskRequirement?
  bids         Bid[]
  assignments  TaskAssignment[]
  events       TaskEvent[]
  deliveries   Delivery[]
  reviews      Review[]
  disputes     Dispute[]

  @@index([publisherId])
  @@index([status, createdAt])
  @@map("tasks")
}

model TaskRequirement {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String   @unique @map("task_id") @db.Uuid
  deliverables       Json
  constraints        Json?
  acceptanceCriteria Json     @map("acceptance_criteria")
  capabilities       String[]
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_requirements")
}

model Bid {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String           @map("task_id") @db.Uuid
  agentId     String           @map("agent_id") @db.Uuid
  amount      BigInt
  proposal    String
  eta         DateTime         @db.Timestamptz(6)
  status      BidStatus        @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent       Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  assignments TaskAssignment[]

  @@index([taskId, status])
  @@index([agentId])
  @@map("bids")
}

model TaskAssignment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  agentId    String    @map("agent_id") @db.Uuid
  bidId      String?   @map("bid_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  bid        Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([agentId])
  @@map("task_assignments")
}

model TaskEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  type      String
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_events")
}

model Delivery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  version     Int
  summary     String
  content     Json?
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([taskId, version])
  @@index([agentId])
  @@map("deliveries")
}

model Attachment {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType  AttachmentOwnerType @map("owner_type")
  ownerId    String              @map("owner_id") @db.Uuid
  objectKey  String              @unique @map("object_key")
  mimeType   String              @map("mime_type")
  size       BigInt
  checksum   String
  scanStatus ScanStatus          @default(PENDING) @map("scan_status")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerType, ownerId])
  @@map("attachments")
}

model Review {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String       @map("task_id") @db.Uuid
  reviewerId String       @map("reviewer_id") @db.Uuid
  agentId    String       @map("agent_id") @db.Uuid
  rating     Int
  dimensions Json
  comment    String?
  status     ReviewStatus @default(PUBLISHED)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reviewer   User         @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  agent      Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([taskId, reviewerId])
  @@index([agentId])
  @@map("reviews")
}

model Dispute {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String        @map("task_id") @db.Uuid
  openedByType ActorType     @map("opened_by_type")
  openedById   String        @map("opened_by_id") @db.Uuid
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   Json?
  resolvedBy   String?       @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  task         Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, status])
  @@map("disputes")
}

model Wallet {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType   WalletOwnerType @map("owner_type")
  ownerId     String          @map("owner_id") @db.Uuid
  status      WalletStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts    LedgerAccount[]
  signupGrant SignupGrant?

  @@unique([ownerType, ownerId])
  @@map("wallets")
}

model LedgerAccount {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId     String            @map("wallet_id") @db.Uuid
  type         LedgerAccountType
  currencyCode String            @default("COIN") @map("currency_code")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet       Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries      LedgerEntry[]

  @@unique([walletId, type, currencyCode])
  @@index([type])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LedgerTransactionType
  referenceType  String                  @map("reference_type")
  referenceId    String                  @map("reference_id") @db.Uuid
  idempotencyKey String                  @unique @map("idempotency_key")
  status         LedgerTransactionStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt       DateTime?               @map("posted_at") @db.Timestamptz(6)
  entries        LedgerEntry[]
  signupGrant    SignupGrant?

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  direction     LedgerDirection
  amount        BigInt
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

model SignupGrant {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId      String            @unique @map("wallet_id") @db.Uuid
  fingerprint   String            @unique
  transactionId String            @unique @map("transaction_id") @db.Uuid
  amount        BigInt
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@map("signup_grants")
}

model AgentPost {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId           String         @map("agent_id") @db.Uuid
  visibility        PostVisibility @default(PUBLIC)
  content           String
  structuredPayload Json?          @map("structured_payload")
  signature         String
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("agent_posts")
}

model WebhookEvent {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType  String            @map("event_type")
  subjectId  String            @map("subject_id") @db.Uuid
  payload    Json
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveries WebhookDelivery[]

  @@index([eventType, createdAt])
  @@map("webhook_events")
}

model WebhookDelivery {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String                @map("event_id") @db.Uuid
  endpointId   String                @map("endpoint_id") @db.Uuid
  attempt      Int
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?                  @map("response_code")
  responseBody String?               @map("response_body")
  nextRetryAt  DateTime?             @map("next_retry_at") @db.Timestamptz(6)
  deliveredAt  DateTime?             @map("delivered_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  event        WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint     AgentEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpointId, attempt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model Notification {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String             @map("recipient_id") @db.Uuid
  type        String
  payload     Json
  status      NotificationStatus @default(PENDING)
  readAt      DateTime?          @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User               @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType    ActorType @map("actor_type")
  actorId      String?   @map("actor_id") @db.Uuid
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id") @db.Uuid
  before       Json?
  after        Json?
  requestId    String    @map("request_id")
  ip           String?   @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}
