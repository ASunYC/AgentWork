{
  "name": "agentwork",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "db:preflight": "pnpm --filter @agentwork/database build && node scripts/env-run.mjs packages/database/dist/preflight-cli.js",
    "agentwork": "node packages/cli/src/cli.mjs",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @agentwork/contracts build && pnpm --filter @agentwork/database build && pnpm --filter @agentwork/ui build && pnpm -r --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @agentwork/contracts build && pnpm --filter @agentwork/ui build && pnpm -r --if-present typecheck",
    "test": "node --test scripts/env.test.mjs && pnpm -r --if-present test",
    "test:startup": "pnpm build && node scripts/smoke-dev.mjs",
    "db:validate": "pnpm --filter @agentwork/database validate",
    "db:generate": "pnpm --filter @agentwork/database generate",
    "db:migrate": "pnpm --filter @agentwork/database build && node scripts/env-run.mjs packages/database/dist/migrate.js",
    "db:seed": "node scripts/env-run.mjs packages/database/node_modules/tsx/dist/cli.mjs packages/database/prisma/seed.ts",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "openapi:generate": "pnpm --filter @agentwork/api openapi:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
